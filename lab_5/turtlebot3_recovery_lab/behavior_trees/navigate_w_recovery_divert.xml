<?xml version="1.0" encoding="UTF-8"?>

<root main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">

    <RecoveryNode
      number_of_retries="3"
      name="NavigateWithCustomRecovery">

      <!-- Primary navigation to the original goal -->
      <PipelineSequence name="NavigateWithReplanning">

        <RateController hz="1.0">
          <ComputePathToPose
            goal="{goal}"
            path="{path}"
            planner_id="GridBased"/>
        </RateController>

        <FollowPath
          path="{path}"
          controller_id="FollowPath"/>

      </PipelineSequence>

      <!-- Custom recovery when normal navigation fails -->
      <Sequence name="CustomPythonRecovery">

        <!-- Clear local costmap -->
        <ClearEntireCostmap
          name="ClearLocalCostmap"
          service_name="/local_costmap/clear_entirely_local_costmap"/>

        <!-- Request diversion waypoint from Python service -->
        <!-- server_timeout (ms): recovery_student.py plans paths to the
             candidates (up to 3 s) and waits for the activation sound to
             play (up to 5 s if a sound is already playing) before
             answering, far longer than the default_server_timeout (200 ms)
             in nav2_params.yaml. -->
        <BeepAndDivertBridge
          recovery_pose="{recovery_pose}"
          server_timeout="10000"/>

        <!-- Plan to diversion waypoint, not original goal -->
        <ComputePathToPose
          goal="{recovery_pose}"
          path="{recovery_path}"
          planner_id="GridBased"/>

        <!-- Execute diversion -->
        <FollowPath
          path="{recovery_path}"
          controller_id="FollowPath"/>

        <!-- Stay at the recovery waypoint while the success sound plays
             (recovery_student.py starts it on arrival; it lasts ~2 s).
             Humble's Wait takes whole seconds. -->
        <Wait wait_duration="3"/>

      </Sequence>

    </RecoveryNode>

  </BehaviorTree>
</root>